{
  "expo": {
    "name": "Satvik Salaad",
    "slug": "satviksalaad",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo/icon.png",
    "scheme": "satviksalaad",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infynixlabs.satviksalaad",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:satviksalaad.com",
        "applinks:www.satviksalaad.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "comgooglemaps",
          "googlemaps",
          "maps"
        ],
        "NSPhotoLibraryUsageDescription": "Satvik Salaad does not access your photo library. This permission string is required by iOS for certain third-party frameworks included in the app."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.infynixlabs.satviksalaad",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/logo/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "satviksalaad.com",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "www.satviksalaad.com",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo/logo-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics",
              "RNFBCrashlytics"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "android": {
            "image": "./assets/logo/logo.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#FBFBF9",
            "dark": {
              "image": "./assets/logo/logo-cream.png",
              "imageWidth": 200,
              "resizeMode": "contain",
              "backgroundColor": "#101814"
            }
          },
          "ios": {
            "image": "./assets/logo/logo.png",
            "imageWidth": 275,
            "resizeMode": "contain",
            "backgroundColor": "#FBFBF9",
            "dark": {
              "image": "./assets/logo/logo-cream.png",
              "imageWidth": 275,
              "resizeMode": "contain",
              "backgroundColor": "#101814"
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo/notification-icon.png",
          "color": "#235C3B",
          "sounds": []
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "@hot-updater/react-native",
        {
          "channel": "production"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": false
        }
      ],
      "./plugins/with-pod-deployment-target"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "54b9f714-0179-4d04-8152-f579c5d5e4a9"
      }
    },
    "owner": "infynixlabs"
  }
}
