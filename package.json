{
  "name": "satviksalaad_mobile_app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npx expo start --clear --port 9090",
    "android": "expo start --android --port 9090",
    "ios": "expo start --ios --port 9090",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint",
    "build-android": "cd android && ./gradlew assembleRelease",
    "ota:ios": "hot-updater deploy -p ios -c production -t 1.0.1",
    "ota:android": "hot-updater deploy -p android -c production -t 1.0.1",
    "ota:all": "hot-updater deploy -p ios -c production -t 1.0.1 && hot-updater deploy -p android -c production -t 1.0.1",
    "ota:all-force": "hot-updater deploy -p ios -c production -t 1.0.1 -f && hot-updater deploy -p android -c production -t 1.0.1 -f",
    "ota:console": "hot-updater console"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/young-serif": "^0.4.0",
    "@expo/vector-icons": "^15.0.3",
    "@hot-updater/react-native": "^1.1.4",
    "@react-native-firebase/analytics": "^26.4.1",
    "@react-native-firebase/app": "^26.4.1",
    "@react-native-firebase/crashlytics": "^26.4.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "expo": "^58.0.0",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-otp-verify": "^1.2.0",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@hot-updater/cloudflare": "^1.1.4",
    "@hot-updater/expo": "^1.1.4",
    "@types/react": "~19.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "hot-updater": "^1.1.4",
    "typescript": "~6.0.3",
    "wrangler": "^4.136.3"
  },
  "private": true
